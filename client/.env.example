# Supabase credentials (get these from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Unique ID for this machine (useful if you control multiple PCs)
DEVICE_ID=default

# Local port for daemon IPC (agent hooks send requests here)
LOCAL_IPC_PORT=49152

# Hook fallback behavior if no decision is made on phone within 45s:
# Options: "ask" (prompt in local agent terminal) or "deny" (hard block)
FALLBACK_DECISION=ask

# Quota polling interval in milliseconds (default 2 minutes)
QUOTA_POLL_INTERVAL_MS=120000

# Media polling interval in milliseconds (default 2.5 seconds)
MEDIA_POLL_INTERVAL_MS=2500
